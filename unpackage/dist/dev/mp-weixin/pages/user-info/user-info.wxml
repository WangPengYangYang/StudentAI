<view class="user-info-container"><view class="progress-bar"><view class="progress-track"><view class="progress-fill" style="{{'width:' + a}}"></view></view><view class="step-indicators"><view wx:for="{{b}}" wx:for-item="step" wx:key="b" class="{{['step-dot', step.c, step.d]}}"><text wx:if="{{step.a}}" class="step-check">✓</text></view></view><text class="step-text">步骤 {{c}}/4</text></view><view class="step-content"><view wx:if="{{d}}" class="step-panel"><text class="step-title">学业背景</text><view class="form-group"><text class="label">最高学历</text><picker bindchange="{{f}}" value="{{g}}" range="{{h}}"><view class="picker">{{e}}</view></picker></view><view class="form-group"><text class="label">毕业院校</text><input class="input" placeholder="请输入毕业院校名称" value="{{i}}" bindinput="{{j}}"/></view><view class="form-group"><text class="label">专业</text><input class="input" placeholder="请输入专业名称" value="{{k}}" bindinput="{{l}}"/></view><view class="form-group"><text class="label">GPA成绩</text><view class="gpa-type-tags"><view wx:for="{{m}}" wx:for-item="type" wx:key="b" class="{{['gpa-tag', type.c]}}" bindtap="{{type.d}}"><text>{{type.a}}</text></view></view><input class="input" placeholder="{{n}}" type="number" value="{{o}}" bindinput="{{p}}"/></view></view><view wx:if="{{q}}" class="step-panel"><text class="step-title">语言/标化成绩</text><view class="form-group"><text class="label">语言考试类型</text><picker bindchange="{{s}}" value="{{t}}" range="{{v}}"><view class="picker">{{r}}</view></picker></view><view class="form-group"><text class="label">成绩状态</text><radio-group bindchange="{{x}}"><label wx:for="{{w}}" wx:for-item="item" wx:key="d" class="radio-label"><radio value="{{item.a}}" checked="{{item.b}}"/><text>{{item.c}}</text></label></radio-group></view><view wx:if="{{y}}" class="form-group"><text class="label">考试成绩</text><input class="input" placeholder="请输入考试成绩" type="number" value="{{z}}" bindinput="{{A}}"/></view><view wx:if="{{B}}" class="form-group"><text class="label">预计考试时间</text><picker mode="date" bindchange="{{D}}"><view class="picker">{{C}}</view></picker></view><view wx:if="{{E}}" class="form-group"><text class="label">AI预测分数</text><text class="predict-score">{{F}}</text><text class="predict-tip">基于你的学习背景预测</text></view></view><view wx:if="{{G}}" class="step-panel"><text class="step-title">实习/工作经历</text><view class="form-group"><text class="label">公司类型</text><picker bindchange="{{I}}" value="{{J}}" range="{{K}}"><view class="picker">{{H}}</view></picker></view><view class="form-group"><text class="label">公司名称</text><input class="input" placeholder="请输入公司名称" value="{{L}}" bindinput="{{M}}"/></view><view class="form-group"><text class="label">职位</text><input class="input" placeholder="请输入职位" value="{{N}}" bindinput="{{O}}"/></view><view class="form-group"><text class="label">工作时长</text><input class="input" placeholder="请输入工作时长（月）" type="number" value="{{P}}" bindinput="{{Q}}"/></view><view class="form-group"><text class="label">工作描述</text><block wx:if="{{r0}}"><textarea class="textarea" placeholder="请描述工作内容和收获" value="{{R}}" bindinput="{{S}}"/></block></view></view><view wx:if="{{T}}" class="step-panel"><text class="step-title">留学意向</text><view class="form-group"><text class="label">目标国家/地区</text><checkbox-group bindchange="{{V}}"><label wx:for="{{U}}" wx:for-item="country" wx:key="d" class="checkbox-label"><checkbox value="{{country.a}}" checked="{{country.b}}"/><text>{{country.c}}</text></label></checkbox-group></view><view class="form-group"><text class="label">目标专业</text><input class="input" placeholder="请输入目标专业" value="{{W}}" bindinput="{{X}}"/></view><view class="form-group"><text class="label">学费预算上限（万元）</text><slider value="{{Y}}" min="10" max="100" bindchange="{{Z}}" show-value/><text class="budget-value">{{aa}} 万元</text></view></view></view><view class="navigation-buttons"><button wx:if="{{ab}}" class="btn-prev" bindtap="{{ac}}">上一步</button><button wx:if="{{ad}}" class="btn-next" bindtap="{{ae}}">下一步</button><button wx:if="{{af}}" class="btn-submit" bindtap="{{ag}}">提交信息</button></view></view>