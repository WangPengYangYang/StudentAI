
.user-info-container {
		padding: 30rpx;
		min-height: 100vh;
		background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}
.progress-bar {
		position: relative;
		margin-bottom: 60rpx;
}
.progress-track {
		height: 8rpx;
		background: #e0e0e0;
		border-radius: 4rpx;
		overflow: hidden;
}
.progress-fill {
		height: 100%;
		background: linear-gradient(90deg, #667eea, #764ba2);
		transition: width 0.3s ease;
}
.step-indicators {
		position: absolute;
		top: -12rpx;
		left: 0;
		right: 0;
		display: flex;
		justify-content: space-between;
}
.step-dot {
		width: 32rpx;
		height: 32rpx;
		border-radius: 50%;
		background: #e0e0e0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 20rpx;
		color: white;
}
.step-dot.completed {
		background: #4CAF50;
}
.step-dot.active {
		background: #667eea;
		border: 3rpx solid #fff;
		box-shadow: 0 0 0 3rpx #667eea;
}
.step-text {
		display: block;
		text-align: center;
		margin-top: 20rpx;
		font-size: 28rpx;
		color: #666;
		font-weight: bold;
}
.step-content {
		background: white;
		border-radius: 20rpx;
		padding: 40rpx;
		margin-bottom: 40rpx;
		box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}
.step-title {
		display: block;
		font-size: 36rpx;
		font-weight: bold;
		color: #333;
		margin-bottom: 40rpx;
		text-align: center;
}
.form-group {
		margin-bottom: 40rpx;
}
.label {
		display: block;
		font-size: 28rpx;
		color: #333;
		margin-bottom: 16rpx;
		font-weight: 500;
}
.input, .textarea, .picker {
		border: 2rpx solid #ddd;
		border-radius: 12rpx;
		padding: 24rpx;
		font-size: 28rpx;
		background: white;
}
.picker {
		color: #333;
}
.textarea {
		height: 200rpx;
}
.radio-label, .checkbox-label {
		display: flex;
		align-items: center;
		margin-right: 40rpx;
		margin-bottom: 20rpx;
		font-size: 28rpx;
}
.gpa-type-tags {
		display: flex;
		gap: 20rpx;
		margin-bottom: 20rpx;
}
.gpa-tag {
		padding: 16rpx 32rpx;
		border: 2rpx solid #ddd;
		border-radius: 12rpx;
		font-size: 24rpx;
		color: #666;
		background: #f8f9fa;
		cursor: pointer;
		transition: all 0.3s ease;
}
.gpa-tag.active {
		background: linear-gradient(135deg, #667eea, #764ba2);
		color: white;
		border-color: #667eea;
}
.predict-score {
		font-size: 36rpx;
		color: #ff6b6b;
		font-weight: bold;
		display: block;
		margin: 10rpx 0;
}
.predict-tip {
		font-size: 24rpx;
		color: #888;
}
.budget-value {
		display: block;
		text-align: center;
		font-size: 32rpx;
		color: #667eea;
		font-weight: bold;
		margin-top: 20rpx;
}
.navigation-buttons {
		display: flex;
		justify-content: space-between;
		gap: 20rpx;
}
.btn-prev, .btn-next, .btn-submit {
		flex: 1;
		border-radius: 12rpx;
		font-size: 28rpx;
		height: 80rpx;
		line-height: 80rpx;
}
.btn-prev {
		background: #f8f9fa;
		color: #666;
		border: 2rpx solid #ddd;
}
.btn-next {
		background: linear-gradient(135deg, #667eea, #764ba2);
		color: white;
}
.btn-submit {
		background: linear-gradient(135deg, #4CAF50, #45a049);
		color: white;
}
