
.login-container {
    position: relative;
}
.content {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
    padding-top: 40%;
    width: 100%;
}
.logo {
		height: 200rpx;
    width: 200rpx;
		margin-left: auto;
		margin-right: auto;
		margin-bottom: 100rpx;
    border-radius: 20rpx;
}
.title {
		font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 24rpx;
}
.sub-title{
    font-size: 28rpx;
    color: #999;
    margin-bottom: 80rpx;
}
.login-btn {
		width: 300rpx;
}
.login-tips {
		margin-top: 20rpx;
		text-align: center;
}
.login-tips text {
		font-size: 24rpx;
		color: #999;
		line-height: 1.5;
}
